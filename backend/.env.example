# Copy to .env and fill in. .env is gitignored.

# ── Swarms cloud API (the multi-agent brain) ─────────────
# Get a key at https://swarms.world/platform/api-keys. Frenzy Mode = zero-cost.
SWARMS_API_KEY=sk-your-key-here

# Model the scout agents use (must be in GET https://api.swarms.world/v1/models/available)
MERIDIAN_MODEL=gpt-4o-mini

# ── Solana data ──────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Pipeline tuning ──────────────────────────────────────
DEX_MIN_LIQUIDITY_USD=5000
DEX_MAX_AGE_HOURS=48

# ── API server ───────────────────────────────────────────
MERIDIAN_API_PORT=8000
MERIDIAN_RUN_SECRET=change-me-before-demo
DATA_DIR=./data

# ── Durable storage (optional but recommended in prod) ────
# When set, the shortlist + call log persist to MongoDB instead of the local
# disk — so data survives Render restarts / sleeps. Get a free cluster at
# https://www.mongodb.com/atlas. Leave blank to use files (DATA_DIR).
MONGODB_URI=
MONGODB_DB=meridian

# ── Token security check (optional, server-side enrichment) ──
# Third-party honeypot / contract-safety lookup used by /api/evaluate. Leave
# blank to disable — evaluate works without it. The URL may include {address}
# as a placeholder; TOKEN_CHECK_ORIGIN is the Origin/Referer to send (optional).
TOKEN_CHECK_API_URL=
TOKEN_CHECK_ORIGIN=

# ── Tokenization wallet (Stream B; filled by scripts/gen_wallet.mjs) ──
CREATOR_WALLET_PUBKEY=
CREATOR_WALLET_PRIVATE_KEY=

# ── Telegram bot (Stream C; python -m meridian.bot) ──────
# Get a token from @BotFather. MERIDIAN_API_URL points the bot at the API.
TELEGRAM_BOT_TOKEN=
MERIDIAN_API_URL=http://localhost:8000
